#Assignment of multiple values to multiple variables
x, y, z = "Orange", "Banana", "Cherry"
print(x)
print(y)
print(z)

#Assign the same value to multiple variables in one line
x = y = z = "Orange"
print(x)
print(y)
print(z)

#Unpack a collection
fruits = ["apple", "banana", "cherry"]
x, y, z = fruits
print(x)
print(y)
print(z)

